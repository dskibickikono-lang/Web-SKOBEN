---
import Base from '../layouts/Base.astro';
---

<Base title="Nie znaleziono strony" heroTone="dark" noindex>
  <section class="nf theme-dark">
    <div class="container nf__inner">
      <p class="label" data-rise>Błąd 404</p>
      <h1 class="display" data-rise style="--reveal-i:1">Ta sprawa nie trafiła do żadnej kolejki.</h1>
      <p class="lede" data-rise style="--reveal-i:2">Strona nie istnieje albo została przeniesiona. Dziennik milczy — sprawdziliśmy.</p>
      <div class="nf__actions" data-rise style="--reveal-i:3">
        <a class="btn btn--primary btn--lg" href="/">Strona główna</a>
        <a class="btn btn--ghost btn--lg" href="/sandbox/">Otwórz sandbox</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    align-items: center;
    min-height: min(100svh, 52rem);
    padding-top: var(--header-h);
    background: var(--ink-900);
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }

  .nf__inner {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
    padding-block: 4rem;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
