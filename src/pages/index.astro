---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureSwitcher from '../components/FeatureSwitcher.astro';
import Film from '../components/Film.astro';
import Vignettes from '../components/Vignettes.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Calculator from '../components/Calculator.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { facts } from '../config/site';

const work = [
  {
    title: 'Zamówienia z e-maili i plików',
    body: 'Agent czyta zamówienie w dowolnym formacie, sprawdza ceny i stany, zakłada dokument w ERP i odpisuje klientowi. Odchylenia trafiają do handlowca z gotową rekomendacją.',
  },
  {
    title: 'Faktury kosztowe',
    body: 'Odczyt, dopasowanie do zamówienia i przyjęcia, dekretacja według Twojego planu kont. Księgowość zatwierdza tylko to, co odbiega od reguł.',
  },
  {
    title: 'Zgłoszenia i reklamacje',
    body: 'Klasyfikacja, komplet danych, odpowiedź albo przekazanie do właściwej osoby — w ramach SLA, które ustalasz Ty.',
  },
  {
    title: 'Reguły i progi',
    body: 'Limit kwoty, tolerancja ceny, lista kontrahentów wymagających akceptacji. Przesuwasz próg — i od razu widzisz, ile spraw agent domknie sam.',
  },
];

const refusals = [
  {
    title: 'Żadnych demo na pokaz',
    body: 'Pilot działa na Twoich realnych sprawach i w Twoich systemach. Albo dowozi uzgodniony miernik, albo nie trafia na produkcję.',
  },
  {
    title: 'Żadnych slajdów zamiast wdrożenia',
    body: 'Nie piszemy strategii AI. Efektem naszej pracy jest działający agent, instrukcja operacyjna i liczba, którą można sprawdzić.',
  },
  {
    title: 'Żadnej czarnej skrzynki',
    body: 'Reguły, progi i uprawnienia są jawne i należą do Ciebie. Każdą decyzję agenta da się odtworzyć z dziennika.',
  },
];

const faq = [
  {
    q: 'Co się dzieje, gdy agent się pomyli?',
    a: 'Zakładamy, że się pomyli — dlatego każda sprawa spoza reguł trafia do człowieka, a każdy zapis ma ślad w dzienniku i da się go cofnąć. W pilocie mierzymy odsetek błędów na Twoich danych i dopiero na tej podstawie ustalamy, co agent może domykać sam.',
  },
  {
    q: 'Czy musimy wymieniać ERP albo CRM?',
    a: 'Nie. Agent pracuje w systemach, które już masz: przez API, pliki wymiany, pocztę, a gdy nie ma innej drogi — przez interfejs użytkownika. Zakres integracji ustalamy na etapie mapowania.',
  },
  {
    q: 'Ile to trwa?',
    a: `Mapowanie jednego procesu zajmuje zwykle ${facts.mapping}, pilot na realnych sprawach ${facts.pilot}. Termin zależy głównie od dostępu do systemów i osób, które znają wyjątki — mówimy o tym wprost na pierwszej rozmowie.`,
  },
  {
    q: 'Od jakiego wolumenu to ma sens?',
    a: 'Od powtarzalności, nie od skali. Jeśli proces ma stałe kroki, mierzalny wolumen i ktoś dziś przepisuje w nim dane między systemami — warto policzyć. Kalkulator powyżej pokaże rząd wielkości, a rozmowa — czy założenia są realne.',
  },
  {
    q: 'Kto jest właścicielem konfiguracji i danych?',
    a: 'Ty. Reguły, progi, instrukcje i dziennik decyzji należą do Twojej organizacji. Agent działa na uprawnieniach, które nadajesz i w każdej chwili możesz odebrać.',
  },
  {
    q: 'Co z danymi osobowymi i tajemnicą handlową?',
    a: 'Agent dostaje dostęp tylko do danych potrzebnych w danym procesie. Zakres przetwarzania, lokalizację danych i umowę powierzenia ustalamy przed pilotem — szczegóły opisujemy na stronie Bezpieczeństwo.',
  },
];
---

<Base heroTone="dark">
  <Hero />

  <!-- Praca -->
  <section class="section theme-dark work">
    <div class="container">
      <FeatureSwitcher id="work" items={work}>
        <a class="link" href="/sandbox/" slot="after">Otwórz sandbox</a>
        <div class="work-film">
          <Film id="work" pan />
          <button class="work-film__toggle" type="button" data-film-toggle aria-label="Wstrzymaj film" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path class="i-pause" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" fill="currentColor"></path>
              <path class="i-play" d="M5 2.8l8 5.2-8 5.2z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </FeatureSwitcher>
    </div>
  </section>

  <!-- Zasady -->
  <section class="section refusals">
    <div class="container">
      <div class="refusals__head">
        <h2 class="h2" data-reveal>
          Nie sprzedajemy „transformacji AI”. Bierzemy jeden proces i&nbsp;dowozimy go do końca.
        </h2>
      </div>
      <div class="grid-3">
        {
          refusals.map((r, i) => (
            <div class="item-rule" data-reveal style={`--reveal-i:${i}`}>
              <span class="label">Zasada 0{i + 1}</span>
              <h3 class="h3">{r.title}</h3>
              <p class="body-2">{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Kontrola -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="vg-head">
        <h2 class="statement" data-reveal>Automatyzacja, którą da się skontrolować.</h2>
      </div>
      <Vignettes />
      <p class="vg-more" data-reveal>
        <a class="link" href="/bezpieczenstwo/">Zobacz model kontroli</a>
      </p>
    </div>
  </section>

  <!-- Przepływ -->
  <section class="section theme-dark flow-section">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal>Agent pracuje w Twoich systemach, nie obok nich.</h2>
        <p class="lede" data-reveal style="--reveal-i:1">
          Nie wymieniamy ERP ani CRM. Podłączamy się tam, gdzie praca już dziś się odbywa — przez API, pliki
          i&nbsp;pocztę.
        </p>
      </div>
      <div data-reveal style="--reveal-i:2">
        <FlowDiagram />
      </div>
      <p class="flow-section__more" data-reveal>
        <a class="link" href="/automatyzacje/">Jak automatyzujemy przepływy</a>
      </p>
    </div>
  </section>

  <!-- Wdrożenie -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal>Od procesu do produkcji w czterech krokach.</h2>
        <p class="lede" data-reveal style="--reveal-i:1">
          Każdy etap ma stały zakres, właściciela po obu stronach i warunek przejścia dalej.
        </p>
      </div>
      <ProcessSteps />
      <p class="steps-more" data-reveal>
        <a class="link" href="/wdrozenie/">Zobacz, co dostajesz na każdym etapie</a>
      </p>
    </div>
  </section>

  <!-- Kalkulator -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal>Policz to na swoich liczbach.</h2>
        <p class="lede" data-reveal style="--reveal-i:1">
          Cztery suwaki, jawne założenia. Wynik to rząd wielkości, z którym warto przyjść na rozmowę.
        </p>
      </div>
      <div data-reveal>
        <Calculator />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--flush-top">
    <div class="container faq-wrap">
      <h2 class="h2" data-reveal>Pytania, które padają na pierwszej rozmowie</h2>
      <div data-reveal style="--reveal-i:1">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  import { mountFilm, whenNear, type FilmHandle, type FilmId } from '../scripts/sandbox/film';

  // Film w sekcji „Jedna kolejka pracy”: każda pozycja listy ma swój film,
  // a po jego zakończeniu lista przechodzi do następnej.
  const fs = document.querySelector<HTMLElement>('.work [data-fs]');
  const stage = fs?.querySelector<HTMLElement>('[data-film]');
  const toggle = fs?.querySelector<HTMLButtonElement>('[data-film-toggle]');
  if (fs && stage) {
    const ids: FilmId[] = ['orders', 'invoices', 'tickets', 'rules'];
    let index = 0;
    let film: FilmHandle | undefined;
    fs.addEventListener('fs:change', (e) => {
      index = (e as CustomEvent<number>).detail;
      film?.play(ids[index] ?? 'orders');
    });
    // konsola filmu powstaje dopiero, gdy sekcja zbliża się do ekranu
    whenNear(stage, () => {
      film = mountFilm(stage, {
        onEnd: () => fs.dispatchEvent(new CustomEvent('fs:goto', { detail: (index + 1) % ids.length })),
        onProgress: (v) => fs.style.setProperty('--fs-progress', String(v)),
      });
      film.play(ids[index] ?? 'orders');
    });
    toggle?.addEventListener('click', () => {
      if (!film) return;
      film.setPaused(!film.paused);
      toggle.setAttribute('aria-pressed', String(film.paused));
      toggle.setAttribute('aria-label', film.paused ? 'Odtwórz film' : 'Wstrzymaj film');
    });
  }
</script>

<style>
  .work-film {
    position: relative;
    width: 100%;
    background: var(--ink-850);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-panel);
  }

  .work-film__toggle {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    z-index: 6;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(236 235 230 / 0.14);
    border: 1px solid rgb(236 235 230 / 0.2);
    color: #ecebe6;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background-color var(--dur-1) ease;
  }

  .work-film__toggle:hover {
    background: rgb(236 235 230 / 0.24);
  }

  .work-film__toggle .i-play,
  .work-film__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .work-film__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  .work {
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
  }

  @media (max-width: 900px) {
    .work-film {
      --film-aspect: 0.92;
    }
  }

  .vg-head {
    padding-top: 1.5rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--line-2);
  }

  .vg-more {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .refusals__head {
    max-width: 52rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .flow-section__more,
  .steps-more {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .faq-wrap > h2 {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  @media (max-width: 860px) {
    .faq-wrap > h2 {
      position: static;
    }

    .faq-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
