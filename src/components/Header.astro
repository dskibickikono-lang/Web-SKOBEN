---
import Logo from './Logo.astro';
import { nav } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);

/** Pasek: „Produkt” rozwija panel, pozostałe pozycje to zwykłe odnośniki. */
const productPaths = ['/agenci/', '/automatyzacje/'];
const barLinks = nav.filter((item) => !productPaths.includes(item.href));
const inProduct = productPaths.some(isCurrent);

const mega = [
  {
    href: '/agenci/',
    title: 'Agenci',
    body: 'Pracownik procesu, nie okno czatu: kolejka, reguły, dziennik.',
    label: 'Kolejki',
    links: [
      { href: '/agenci/#zamowienia', label: 'Agent zamówień' },
      { href: '/agenci/#faktury', label: 'Agent faktur kosztowych' },
      { href: '/agenci/#zgloszenia', label: 'Agent zgłoszeń' },
      { href: '/agenci/#uzgodnienia', label: 'Agent uzgodnień i raportów' },
    ],
  },
  {
    href: '/automatyzacje/',
    title: 'Automatyzacje',
    body: 'Cały przepływ wokół agenta — od wpływu sprawy do zapisu.',
    label: 'Przepływy',
    links: [
      { href: '/automatyzacje/#szkielet', label: 'Szkielet przepływu' },
      { href: '/automatyzacje/#wejscia', label: 'Wejścia i wyjścia' },
      { href: '/automatyzacje/#integracje', label: 'Integracje z systemami' },
      { href: '/automatyzacje/#awarie', label: 'Awarie i eskalacje' },
    ],
  },
];
---

<header class="site-header" data-header>
  <div class="site-header__bar container">
    <a class="site-header__logo" href="/" aria-label="SKOBEN — strona główna">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Główna">
      <ul>
        <li>
          <button
            class:list={['site-header__item', { 'is-current': inProduct }]}
            type="button"
            aria-expanded="false"
            aria-controls="mega-product"
            data-mega-toggle
          >
            Produkt
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true">
              <path d="M3 4.5 6 7.5l3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
        {
          barLinks.map((item) => (
            <li>
              <a class="site-header__item" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__text-link" href="/sandbox/" aria-current={isCurrent('/sandbox/') ? 'page' : undefined}>
        Sandbox
      </a>
      <a class="btn btn--primary btn--sm site-header__cta" href="/kontakt/">Poproś o dostęp</a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path class="bar bar--a" d="M4 8.5h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path class="bar bar--b" d="M4 15.5h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mega" id="mega-product" data-mega hidden>
    <div class="mega__grid">
      <div class="mega__intro">
        <p class="mega__title">Agenci AI w procesach operacyjnych</p>
        <p class="mega__body">Jedna kolejka pracy, reguły ustawione przez Ciebie i dziennik każdej decyzji.</p>
        <a class="mega__row" href="/sandbox/">
          <strong>Sandbox</strong>
          <span>Uruchom kolejkę, zatwierdź wyjątek, przesuń próg</span>
        </a>
        <a class="mega__row" href="/wdrozenie/">
          <strong>Wdrożenie</strong>
          <span>Cztery etapy, stały zakres i warunek przejścia dalej</span>
        </a>
        <a class="mega__pill" href="/sandbox/">
          Otwórz sandbox
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true">
            <path d="M3.5 8.5l5-5M4.5 3.5h4v4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      {
        mega.map((col) => (
          <div class="mega__col">
            <a class="mega__head" href={col.href}>
              <strong>{col.title}</strong>
              <span>{col.body}</span>
            </a>
            <p class="label">{col.label}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <a class="mega__foot" href="/bezpieczenstwo/">
      <span class="mega__foot-title">
        Bezpieczeństwo
        <span class="mega__arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </span>
      <span>Cztery warstwy między modelem a Twoim systemem: uprawnienia, reguły, akceptacja człowieka, dziennik.</span>
    </a>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Menu mobilne">
      <ul>
        {
          [...nav, { href: '/sandbox/', label: 'Sandbox' }].map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span>{item.label}</span>
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary btn--lg mobile-menu__cta" href="/kontakt/">Poproś o dostęp</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    // Kolory nagłówka pochodzą z motywu strony (body[data-theme]); tu tylko stan „przewinięto”.
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        // wymuszenie reflow, żeby przejście wejścia zadziałało
        void menu.offsetHeight;
        menu.classList.add('is-visible');
      } else {
        menu.classList.remove('is-visible');
        window.setTimeout(() => {
          if (toggle.getAttribute('aria-expanded') === 'false') menu.hidden = true;
        }, 260);
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Panel „Produkt”: otwiera się po najechaniu (z krótką zwłoką) albo kliknięciu,
  // zamyka po zjechaniu, Escape, kliknięciu obok i wyjściu fokusu.
  const megaToggle = document.querySelector<HTMLButtonElement>('[data-mega-toggle]');
  const megaPanel = document.querySelector<HTMLElement>('[data-mega]');

  if (header && megaToggle && megaPanel) {
    let timer = 0;
    const isOpen = () => megaToggle.getAttribute('aria-expanded') === 'true';
    const setMega = (open: boolean) => {
      window.clearTimeout(timer);
      if (open === isOpen()) return;
      megaToggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-mega', open);
      if (open) {
        megaPanel.hidden = false;
        void megaPanel.offsetHeight;
        megaPanel.classList.add('is-visible');
      } else {
        megaPanel.classList.remove('is-visible');
        timer = window.setTimeout(() => {
          if (!isOpen()) megaPanel.hidden = true;
        }, 220);
      }
    };
    const later = (open: boolean, ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => setMega(open), ms);
    };

    megaToggle.addEventListener('click', () => setMega(!isOpen()));
    if (window.matchMedia('(hover: hover)').matches) {
      megaToggle.addEventListener('pointerenter', () => later(true, 80));
      megaToggle.addEventListener('pointerleave', () => later(false, 160));
      megaPanel.addEventListener('pointerenter', () => window.clearTimeout(timer));
      megaPanel.addEventListener('pointerleave', () => later(false, 160));
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setMega(false);
        megaToggle.focus();
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !megaPanel.contains(e.target as Node) && !megaToggle.contains(e.target as Node)) setMega(false);
    });
    header.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (isOpen() && next && !megaPanel.contains(next) && next !== megaToggle) setMega(false);
    });
    megaPanel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMega(false);
    });
  }
</script>

<style>
  /* Nagłówek dziedziczy motyw całej strony, więc zmienia kolor razem z tłem. */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--text);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    z-index: -1;
  }

  .site-header.is-scrolled::before,
  .site-header.is-open::before,
  .site-header.is-mega::before {
    opacity: 1;
  }

  .site-header.is-open::before,
  .site-header.is-mega::before {
    background: var(--bg);
  }

  /* nad sceną hero nawigacja zostaje przezroczysta (klasę ustawia Hero.astro) */
  :global(html.over-scene) .site-header:not(.is-open, .is-mega)::before {
    opacity: 0;
  }

  .site-header__bar {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    max-width: none;
    padding-inline: var(--gutter);
  }

  .site-header__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .site-header__item,
  .site-header__text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-radius: var(--radius-pill);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    color: var(--text);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  /* hover: sama pigułka tła, bez ruchu */
  .site-header__item:hover,
  .site-header__text-link:hover,
  .site-header__item[aria-current='page'],
  .site-header__item.is-current,
  .site-header__item[aria-expanded='true'],
  .site-header__text-link[aria-current='page'] {
    background: var(--glass);
  }

  .site-header__item svg {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .site-header__item[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Panel „Produkt”: szeroki, trzy kolumny, cienkie linie */
  .mega {
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .mega.is-visible {
    opacity: 1;
    transform: none;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .mega__grid > * {
    padding: 2rem var(--gutter) 2.25rem;
  }

  .mega__grid > * + * {
    border-left: 1px solid var(--line);
  }

  .mega__intro,
  .mega__col {
    display: grid;
    align-content: start;
  }

  .mega__title,
  .mega__head strong,
  .mega__row strong,
  .mega__foot-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 480;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--text);
  }

  .mega__body,
  .mega__head span,
  .mega__row span,
  .mega__foot > span:last-child {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-2);
  }

  .mega__body {
    margin-top: 0.25rem;
    margin-bottom: 1.5rem;
    max-width: 22rem;
  }

  .mega__row {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .mega__row strong {
    font-size: 1rem;
  }

  .mega__row:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .mega__pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    margin-top: 1.5rem;
    padding-inline: 1rem;
    border-radius: var(--radius-pill);
    background: var(--glass);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .mega__pill:hover {
    background: var(--glass-line);
  }

  .mega__head {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 1.75rem;
    max-width: 21rem;
  }

  .mega__col .label {
    margin-bottom: 0.5rem;
    color: var(--text-3);
  }

  .mega__col li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    margin-left: -0.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    color: var(--text);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .mega__col li a:hover,
  .mega__row:hover strong,
  .mega__head:hover strong {
    background: var(--glass);
  }

  .mega__row:hover strong,
  .mega__head:hover strong {
    background: none;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .mega__foot {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem var(--gutter) 1.75rem;
    border-top: 1px solid var(--line);
  }

  .mega__foot-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .mega__arrow {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--glass);
    transition:
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .mega__foot:hover .mega__arrow {
    background: var(--glass-line);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .mega {
      transition: none;
      transform: none;
    }
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem;
    place-items: center;
    border-radius: 50%;
    color: var(--text);
  }

  .site-header__toggle .bar {
    transform-origin: 12px 12px;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .site-header.is-open .bar--a {
    transform: translateY(3.5px) rotate(45deg);
  }

  .site-header.is-open .bar--b {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .mobile-menu.is-visible {
    opacity: 1;
  }

  .mobile-menu nav {
    display: grid;
    gap: 2rem;
    padding-block: 1rem 3rem;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.125rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  .mobile-menu li svg {
    color: var(--text-3);
  }

  @media (max-width: 960px) {
    .site-header__bar {
      grid-template-columns: 1fr auto;
    }

    .site-header__nav,
    .site-header__text-link,
    .mega {
      display: none;
    }

    .site-header__toggle {
      display: grid;
    }
  }

  @media (max-width: 420px) {
    .site-header__cta {
      display: none;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
