---
import { facts } from '../config/site';

const steps = [
  {
    title: 'Mapowanie',
    time: facts.mapping,
    body: 'Rozkładamy jeden proces na kroki, wyjątki i wolumeny. Ustalamy miernik bazowy: ile spraw, ile minut, ile błędów.',
  },
  {
    title: 'Pilot',
    time: facts.pilot,
    body: 'Agent pracuje na realnych sprawach — najpierw w cieniu, potem z akceptacją człowieka. Porównujemy wynik z miernikiem.',
  },
  {
    title: 'Produkcja',
    time: 'po akceptacji pilota',
    body: 'Przekazujemy kolejkę, uprawnienia i instrukcję operacyjną. Zespół zajmuje się wyjątkami, nie przepisywaniem.',
  },
  {
    title: 'Utrzymanie',
    time: 'w trybie ciągłym',
    body: 'Pilnujemy jakości, reagujemy na zmiany w systemach i dokładamy reguły, gdy proces się zmienia.',
  },
];
---

<ol class="steps" data-reveal>
  {
    steps.map((s, i) => (
      <li class="steps__item" style={`--i:${i}`}>
        <div class="steps__rail" aria-hidden="true">
          <span class="steps__node" />
        </div>
        <span class="label">
          0{i + 1} · {s.time}
        </span>
        <h3 class="h3">{s.title}</h3>
        <p class="body-2 small">{s.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .steps__item {
    display: grid;
    align-content: start;
    gap: 0.625rem;
  }

  .steps__rail {
    position: relative;
    height: 1.5rem;
    margin-bottom: 1rem;
    margin-right: calc(clamp(1.5rem, 1rem + 2vw, 3rem) * -1);
  }

  .steps__item:last-child .steps__rail {
    margin-right: 0;
  }

  .steps__rail::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: var(--line-2);
    transform-origin: 0 50%;
  }

  :global(.js) .steps .steps__rail::before {
    transform: scaleX(0);
    transition: transform 900ms var(--ease-in-out);
    transition-delay: calc(var(--i) * 260ms + 200ms);
  }

  :global(.js) .steps:global(.is-in) .steps__rail::before {
    transform: scaleX(1);
  }

  .steps__node {
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .steps .label {
    margin-bottom: 0.25rem;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .steps__item {
      position: relative;
      padding: 0 0 2.25rem 2rem;
    }

    .steps__item:last-child {
      padding-bottom: 0;
    }

    .steps__rail {
      position: absolute;
      inset: 0.35rem auto 0 0;
      width: 9px;
      height: auto;
      margin: 0;
    }

    .steps__rail::before {
      inset: 0 auto 0 4px;
      width: 1px;
      height: auto;
      transform: none !important;
    }

    .steps__item:last-child .steps__rail::before {
      display: none;
    }

    .steps__node {
      top: 0;
      margin-top: 0;
    }
  }
</style>
