---
import { facts } from '../config/site';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Pokaż nam jeden proces.',
  body = `W ${facts.callLength} powiemy, czy agent ma w nim sens, co trzeba mieć gotowe i ile potrwa pilot.`,
} = Astro.props;

// Na stronie sandboxa nie odsyłamy do sandboxa — drugim krokiem jest przebieg wdrożenia.
const onSandbox = Astro.url.pathname.startsWith('/sandbox');
const second = onSandbox
  ? {
      href: '/wdrozenie/',
      cta: 'Zobacz przebieg wdrożenia',
      label: 'Wdrożenie',
      title: 'Cztery etapy, stały zakres i warunek przejścia dalej',
      body: 'Mapowanie, pilot, produkcja, utrzymanie.',
    }
  : {
      href: '/sandbox/',
      cta: 'Otwórz sandbox',
      label: 'Sandbox',
      title: 'Sprawdź, jak pracuje agent — zanim porozmawiamy',
      body: 'Uruchom kolejkę, zatwierdź wyjątek, przesuń próg.',
    };
---

<section class="cta-band" data-theme="dark">
  <div class="container cta-band__inner" data-reveal>
    <h2 class="h2">{title}</h2>
    <p class="lede">{body}</p>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href="/kontakt/">Poproś o dostęp</a>
      <a class="btn btn--glass" href={second.href}>{second.cta}</a>
    </div>

    <ul class="cta-band__cards">
      <li>
        <a href={second.href}>
          <span class="label">{second.label}</span>
          <strong>{second.title}</strong>
          <span>{second.body}</span>
        </a>
      </li>
      <li>
        <a href="/kontakt/">
          <span class="label">Dostęp</span>
          <strong>Wdrażamy równolegle tylko kilka firm</strong>
          <span>Zaczynamy od rozmowy o jednym procesie.</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--pad-xl) 0;
    color: var(--text);
  }

  .cta-band__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
  }

  .cta-band .h2 {
    max-width: 40rem;
  }

  .cta-band .lede {
    max-width: 34rem;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .cta-band__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    width: 100%;
    margin-top: var(--pad-md);
    text-align: left;
  }

  .cta-band__cards a {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    height: 100%;
    min-height: 11rem;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--surface);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .cta-band__cards a:hover {
    background: var(--surface-2);
  }

  .cta-band__cards strong {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.3125rem, 1.2rem + 0.45vw, 1.5rem);
    font-weight: 480;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .cta-band__cards a > span:last-child {
    color: var(--text-2);
  }

  @media (max-width: 760px) {
    .cta-band__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .cta-band__cards a {
      min-height: 0;
      padding: 1.25rem;
    }
  }
</style>
