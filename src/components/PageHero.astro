---
interface Props {
  title: string;
  lede: string;
  tone?: 'light' | 'dark';
  eyebrow?: string;
  /** Kadr pod nagłówkiem: nazwa pary plików w /media/pages/ (…-wide.webp, …-tall.webp) i opis. */
  image?: { name: string; alt: string };
}
const { title, lede, tone = 'light', eyebrow, image } = Astro.props;
---

<section class="page-hero" data-theme={tone}>
  <div class="container">
    <div class="page-hero__inner">
      {eyebrow && <p class="label" data-rise>{eyebrow}</p>}
      <h1 class="display" data-rise>{title}</h1>
      <p class="lede" data-rise style="--reveal-i:1">{lede}</p>
      {
        Astro.slots.has('default') && (
          <div class="page-hero__actions" data-rise style="--reveal-i:2">
            <slot />
          </div>
        )
      }
    </div>
  </div>
  {
    image && (
      <div class="container">
        <picture class="page-hero__media" data-rise style="--reveal-i:3">
          <source media="(max-width: 640px)" srcset={`/media/pages/${image.name}-tall.webp`} width="1024" height="768" />
          <img
            src={`/media/pages/${image.name}-wide.webp`}
            alt={image.alt}
            width="2048"
            height="853"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    )
  }
  <slot name="art" />
</section>

