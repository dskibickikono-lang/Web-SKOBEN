---
interface Props {
  title: string;
  lede: string;
  tone?: 'light' | 'dark';
  eyebrow?: string;
}
const { title, lede, tone = 'light', eyebrow } = Astro.props;
---

<section class:list={['page-hero', tone === 'dark' ? 'theme-dark' : 'theme-light']}>
  <div class="container">
    <div class="page-hero__inner">
      {eyebrow && <p class="label" data-rise>{eyebrow}</p>}
      <h1 class="display" data-rise>{title}</h1>
      <p class="lede" data-rise style="--reveal-i:1">{lede}</p>
      {
        Astro.slots.has('default') && (
          <div class="page-hero__actions" data-rise style="--reveal-i:2">
            <slot />
          </div>
        )
      }
    </div>
  </div>
  <div class="page-hero__arch" aria-hidden="true"><i></i><i></i><i></i></div>
  <slot name="art" />
</section>

<style>
  /* Motyw bramy na podstronach: trzy łuki rozsuwają się w głąb wraz z przewijaniem */
  .page-hero__arch {
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--container)) / 2));
    bottom: 0;
    width: min(26rem, 34vw);
    aspect-ratio: 1 / 1.08;
    pointer-events: none;
  }

  .page-hero__arch i {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px 999px 0 0;
    border: 1px solid var(--line-2);
    border-bottom: 0;
    transform: translateX(-50%) scale(var(--s, 1));
    transform-origin: 50% 100%;
  }

  .page-hero__arch i:nth-child(2) {
    --s: 0.76;
    border-color: color-mix(in srgb, var(--warn) 55%, transparent);
  }

  .page-hero__arch i:nth-child(3) {
    --s: 0.54;
    background: radial-gradient(80% 60% at 50% 100%, color-mix(in srgb, var(--warn) 26%, transparent), transparent 72%);
  }

  @supports (animation-timeline: scroll()) {
    .page-hero__arch i {
      animation: arch-open linear both;
      animation-timeline: scroll(root);
      animation-range: 0 70vh;
    }

    .page-hero__arch i:nth-child(2) {
      --to: 0.9;
    }

    .page-hero__arch i:nth-child(3) {
      --to: 0.82;
    }

    @keyframes arch-open {
      to {
        transform: translateX(-50%) scale(var(--to, 1.12));
        opacity: 0.35;
      }
    }
  }

  @media (max-width: 900px) {
    .page-hero__arch {
      display: none;
    }
  }
</style>
