---
/**
 * Trzy generatywne sceny SVG do sekcji „kontrola”:
 * bramka z akceptacją człowieka, dziennik decyzji, progi reguł.
 * Animacje: SMIL (ruch po ścieżce) + CSS transform/opacity.
 */
const rings = [64, 118, 172, 226];
const journal = [
  { w: 150, t: '08:14:02' },
  { w: 210, t: '08:14:05' },
  { w: 120, t: '08:14:09' },
  { w: 180, t: '08:14:11', warn: true },
  { w: 96, t: '08:16:40' },
  { w: 230, t: '08:16:41' },
  { w: 140, t: '08:16:44' },
  { w: 190, t: '08:16:52' },
];
const tracks = [
  { y: 150, pos: 0.32, label: 'tolerancja ceny', value: '2%' },
  { y: 220, pos: 0.58, label: 'limit kwoty', value: '25 000 zł' },
  { y: 290, pos: 0.78, label: 'pewność odczytu', value: '90%' },
];
const dots = Array.from({ length: 32 }, (_, i) => ({
  x: 108 + (i % 8) * 38,
  y: 372 + Math.floor(i / 8) * 34,
  human: [5, 11, 14, 22, 27, 30].includes(i),
}));
---

<!-- 1. Bramka -->
<div class="art">
  <svg viewBox="0 0 480 560" fill="none" role="presentation">
    {rings.map((r, i) => <circle cx="240" cy="290" r={r} class="ring" style={`--i:${i}`} />)}
    <path id="art-track" d="M28 290H452" class="track" />
    <path id="art-bypass" d="M28 290H150C186 290 190 172 240 172S294 290 330 290H452" class="track track--warn" />
    <path d="M240 258v64" class="gate" />
    <rect x="234" y="284" width="12" height="12" rx="2" transform="rotate(45 240 290)" class="gate-knot" />

    <g class="person">
      <circle cx="240" cy="172" r="19" />
      <circle cx="240" cy="167" r="4.5" />
      <path d="M231 181.5c1.8-4 5.2-6 9-6s7.2 2 9 6" />
    </g>

    {
      [0, 2.1, 4.2].map((begin) => (
        <circle r="4" class="dot">
          <animateMotion dur="6.3s" begin={`-${begin}s`} repeatCount="indefinite" calcMode="linear">
            <mpath href="#art-track" />
          </animateMotion>
        </circle>
      ))
    }
    <circle r="4.5" class="dot dot--warn">
      <animateMotion
        dur="9s"
        begin="-1s"
        repeatCount="indefinite"
        calcMode="spline"
        keyTimes="0;0.42;0.6;1"
        keyPoints="0;0.5;0.5;1"
        keySplines="0.3 0 0.4 1;0 0 1 1;0.6 0 0.7 1"
      >
        <mpath href="#art-bypass" />
      </animateMotion>
    </circle>

    <text x="452" y="312" text-anchor="end" class="cap">bez dotknięcia</text>
    <text x="240" y="136" text-anchor="middle" class="cap cap--warn">akceptacja</text>
  </svg>
</div>

<!-- 2. Dziennik -->
<div class="art">
  <svg viewBox="0 0 480 560" fill="none" role="presentation">
    <path d="M132 96v368" class="spine" />
    {
      journal.map((row, i) => (
        <g class:list={['entry', { 'entry--warn': row.warn }]} style={`--i:${i}`}>
          <text x="112" y={124 + i * 44} text-anchor="end" class="cap">{row.t}</text>
          <circle cx="132" cy={120 + i * 44} r="4" class="entry__dot" />
          <rect x="152" y={113 + i * 44} width={row.w} height="14" rx="7" class="entry__bar" />
          <rect x={152 + row.w + 10} y={113 + i * 44} width={34 + ((i * 17) % 40)} height="14" rx="7" class="entry__bar entry__bar--dim" />
        </g>
      ))
    }
  </svg>
</div>

<!-- 3. Progi -->
<div class="art">
  <svg viewBox="0 0 480 560" fill="none" role="presentation">
    {
      tracks.map((t, i) => (
        <g class="rule" style={`--i:${i}`}>
          <text x="90" y={t.y - 16} class="cap">{t.label}</text>
          <text x="390" y={t.y - 16} text-anchor="end" class="cap cap--strong">{t.value}</text>
          <path d={`M90 ${t.y}H390`} class="rule__track" />
          <path d={`M90 ${t.y}H${90 + 300 * t.pos}`} class="rule__fill" />
          <g class="rule__knob" style={`transform-origin:${90 + 300 * t.pos}px ${t.y}px`}>
            <circle cx={90 + 300 * t.pos} cy={t.y} r="9" class="rule__knob-ring" />
            <circle cx={90 + 300 * t.pos} cy={t.y} r="3" class="rule__knob-core" />
          </g>
        </g>
      ))
    }
    {dots.map((d, i) => <circle cx={d.x} cy={d.y} r="6" class:list={['case', { 'case--human': d.human }]} style={`--i:${i}`} />)}
    <text x="90" y="520" class="cap">26 bez dotknięcia</text>
    <text x="390" y="520" text-anchor="end" class="cap cap--warn">6 do akceptacji</text>
  </svg>
</div>

<style>
  .art {
    align-self: center;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 480 / 560;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 50% 52%, var(--bone-0) 0%, var(--bone-100) 62%, #ebe8e0 100%);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  .cap {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    fill: var(--text-3);
  }

  .cap--warn {
    fill: var(--brass-700);
  }

  .cap--strong {
    fill: var(--text);
  }

  /* Bramka */
  .ring {
    stroke: var(--text);
    stroke-opacity: calc(0.2 - var(--i) * 0.04);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: ring-breathe 7s var(--ease-in-out) infinite alternate;
    animation-delay: calc(var(--i) * -1.4s);
  }

  @keyframes ring-breathe {
    to {
      transform: scale(1.035);
    }
  }

  .track {
    stroke: var(--text);
    stroke-opacity: 0.5;
    stroke-width: 1;
  }

  .track--warn {
    stroke: var(--brass-700);
    stroke-opacity: 0.7;
    stroke-dasharray: 3 5;
  }

  .gate {
    stroke: var(--text);
    stroke-width: 1.25;
  }

  .gate-knot {
    fill: var(--bone-0);
    stroke: var(--text);
    stroke-width: 1.25;
  }

  .person circle:first-child {
    fill: var(--bone-0);
    stroke: var(--brass-700);
    stroke-width: 1.25;
  }

  .person circle:nth-child(2),
  .person path {
    stroke: var(--brass-700);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .dot {
    fill: var(--green-600);
  }

  .dot--warn {
    fill: var(--brass-500);
    stroke: var(--bone-0);
    stroke-width: 1.5;
  }

  /* Dziennik */
  .spine {
    stroke: var(--text);
    stroke-opacity: 0.25;
  }

  .entry {
    animation: entry-in 9.6s var(--ease-out) infinite backwards;
    animation-delay: calc(var(--i) * 0.42s);
  }

  @keyframes entry-in {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    6%,
    86% {
      opacity: 1;
      transform: none;
    }
    94%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .entry__dot {
    fill: var(--bone-0);
    stroke: var(--text);
    stroke-width: 1.25;
  }

  .entry__bar {
    fill: var(--text);
    fill-opacity: 0.78;
  }

  .entry__bar--dim {
    fill-opacity: 0.14;
  }

  .entry--warn .entry__dot {
    fill: var(--brass-500);
    stroke: var(--brass-700);
  }

  .entry--warn .entry__bar {
    fill: var(--brass-700);
    fill-opacity: 0.9;
  }

  .entry--warn .entry__bar--dim {
    fill-opacity: 0.25;
  }

  /* Progi */
  .rule__track {
    stroke: var(--text);
    stroke-opacity: 0.18;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rule__fill {
    stroke: var(--green-600);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rule__knob {
    animation: knob-nudge 5s var(--ease-in-out) infinite alternate;
    animation-delay: calc(var(--i) * -1.7s);
  }

  @keyframes knob-nudge {
    0%,
    30% {
      transform: translateX(-5px);
    }
    70%,
    100% {
      transform: translateX(5px);
    }
  }

  .rule__knob-ring {
    fill: var(--bone-0);
    stroke: var(--green-600);
    stroke-width: 1.5;
  }

  .rule__knob-core {
    fill: var(--green-600);
  }

  .case {
    fill: var(--green-600);
    fill-opacity: 0.85;
  }

  .case--human {
    fill: var(--bone-0);
    fill-opacity: 1;
    stroke: var(--brass-700);
    stroke-width: 1.5;
    animation: case-pulse 2.8s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.23s);
  }

  @keyframes case-pulse {
    50% {
      stroke-opacity: 0.35;
    }
  }
</style>
