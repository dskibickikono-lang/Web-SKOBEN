---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none">
    <!-- Skobel: klamra spinająca dwa elementy -->
    <path d="M6 18.5V9a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <path d="M2.5 18.5h19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <circle cx="12" cy="12.25" r="1.35" fill="currentColor"></circle>
  </svg>
  <span class="logo__word">SKOBEN</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: inherit;
  }

  .logo__word {
    font-size: 0.9375rem;
    font-weight: 620;
    letter-spacing: 0.2em;
    line-height: 1;
    /* kompensacja światła po ostatniej literze */
    margin-right: -0.2em;
  }
</style>
