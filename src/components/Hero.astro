---
/**
 * Hero filmowe: brama. Łuk ze znaku SKOBEN jest wejściem do świata, w którym
 * pracują agenci. Scena jest przypięta na czas przewijania: pierwsze ruchy nie
 * przesuwają strony, tylko prowadzą kamerę przez łuk, aż konsola w jego głębi
 * wypełni widok. Dopiero potem strona rusza dalej. Wszystko to CSS (gradienty,
 * transformacje) — na ekranie działa prawdziwa konsola sterowana skryptem.
 */
import Film from './Film.astro';
---

<section class="cine theme-dark" data-cine>
  <div class="cine__stage">
    <div class="cine__air" aria-hidden="true"></div>
    <div class="cine__shade" aria-hidden="true"></div>

    <div class="container cine__copy" data-cine-copy>
      <h1 class="display" data-rise>Wejdź do świata, w&nbsp;którym praca domyka się sama</h1>
      <p class="lede cine__lede" data-rise style="--reveal-i:1">
        SKOBEN wprowadza firmy w operacje prowadzone przez agentów AI. Zamówienia, faktury i&nbsp;zgłoszenia
        domykają się bez przepisywania — z&nbsp;człowiekiem przy wyjątkach.
      </p>
      <div class="cine__actions" data-rise style="--reveal-i:2">
        <form class="hero__form" action="/kontakt/" method="get">
          <label class="visually-hidden" for="hero-email">Służbowy adres e-mail</label>
          <input id="hero-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Służbowy e-mail" required />
          <button class="btn btn--primary" type="submit">Poproś o dostęp</button>
        </form>
        <a class="btn btn--ghost cine__demo" href="/sandbox/">Otwórz sandbox</a>
      </div>
    </div>

    <div class="cine__rig" data-cine-rig aria-hidden="true">
      <div class="portal" data-cine-portal>
        <div class="portal__light"></div>
        <div class="portal__floor"></div>
      </div>
      <div class="cine__screen">
        <Film id="hero" />
      </div>
    </div>

    <div class="cine__hint" data-cine-hint aria-hidden="true">
      <span>Przewiń, żeby wejść</span>
      <i></i>
    </div>
  </div>
</section>

<script>
  import { mountFilm } from '../scripts/sandbox/film';

  const section = document.querySelector<HTMLElement>('[data-cine]');
  const rig = section?.querySelector<HTMLElement>('[data-cine-rig]');
  const copy = section?.querySelector<HTMLElement>('[data-cine-copy]');
  const portal = section?.querySelector<HTMLElement>('[data-cine-portal]');
  const hint = section?.querySelector<HTMLElement>('[data-cine-hint]');
  const filmEl = section?.querySelector<HTMLElement>('[data-film]');

  if (section && rig && copy && portal && hint && filmEl) {
    const film = mountFilm(filmEl, { loop: true });
    film.play('orders');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const FILM_RATIO = 1180 / 652;

    let vw = 0;
    let vh = 0;
    let wf = 0; // szerokość ekranu laptopa przy pełnym najeździe
    let k0 = 0.3; // skala początkowa
    let ty0 = 0;
    let txEnd = 0;
    let ticking = false;

    const measure = () => {
      vw = window.innerWidth;
      vh = window.innerHeight;
      const header = 72;
      // przy pełnym najeździe ekran wypełnia szerokość okna; na wąskich ekranach
      // jest szerszy od okna, żeby interfejs pozostał czytelny
      const wide = vw < 760 ? vw * 2.5 : vw;
      wf = Math.min(wide, (vh - header - 24) * FILM_RATIO);
      // na starcie ekran stoi w głębi bramy; łuk jest ~1,46× szerszy od ekranu
      const ws = Math.min(Math.max(vw * 0.24, 215), 360);
      k0 = ws / wf;
      // podłoga bramy przy dolnej krawędzi sceny: środek ekranu = podłoga − (16 + 27,5)% szerokości
      ty0 = vh * 0.93 - 0.435 * ws - vh / 2;
      txEnd = Math.max(0, (wf - vw) / 2);
      rig.style.setProperty('--wf', `${wf}px`);
      rig.classList.add('is-ready');
      update();
    };

    const update = () => {
      ticking = false;
      const span = Math.max(1, section.offsetHeight - vh);
      const p = reduce ? 0 : clamp(-section.getBoundingClientRect().top / span);
      const e = ease(clamp(p / 0.78));
      const k = k0 + (1 - k0) * e;
      const ty = ty0 * (1 - e) + 36 * e;
      rig.style.transform = `translate3d(calc(-50% + ${txEnd * e}px), calc(-50% + ${ty}px), 0) scale(${k})`;
      copy.style.opacity = String(1 - clamp(p / 0.14));
      copy.style.transform = `translate3d(0, ${-p * 160}px, 0)`;
      copy.style.visibility = p > 0.16 ? 'hidden' : 'visible';
      portal.style.opacity = String(1 - clamp((p - 0.42) / 0.3));
      hint.style.opacity = String(1 - clamp(p / 0.05));
      section.classList.toggle('is-inside', p > 0.62);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    measure();
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Adres e-mail przekazujemy do formularza kontaktowego przez pamięć sesji,
  // nie w adresie URL — nie trafia do historii ani logów serwera.
  const heroForm = document.querySelector<HTMLFormElement>('.hero__form');
  heroForm?.addEventListener('submit', (e) => {
    const input = heroForm.querySelector<HTMLInputElement>('input[type="email"]');
    if (!input || !heroForm.checkValidity()) return;
    try {
      window.sessionStorage.setItem('skoben:email', input.value.trim());
    } catch {
      return; // bez pamięci sesji zostaje zwykłe wysłanie formularza (GET)
    }
    e.preventDefault();
    window.location.assign(heroForm.action);
  });
</script>

<style>
  .cine {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    background: var(--ink-900);
    color: var(--text);
  }

  /* Z JavaScriptem sekcja jest dłuższa: nadmiar wysokości to „tor” najazdu kamery */
  :global(.js) .cine {
    height: 330svh;
  }

  .cine__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 40rem;
    overflow: clip;
    isolation: isolate;
    background: var(--ink-950);
  }

  /* Powietrze sali: dwa wolno dryfujące snopy ciepłego światła i prążek ściany */
  .cine__air {
    position: absolute;
    inset: -20%;
    z-index: -2;
    background:
      radial-gradient(38% 30% at 50% 78%, rgb(217 170 118 / 0.34), transparent 70%),
      radial-gradient(60% 46% at 50% 100%, rgb(42 117 97 / 0.26), transparent 72%),
      repeating-linear-gradient(to right, rgb(236 235 230 / 0.022) 0 1px, transparent 1px 84px);
    animation: air-drift 18s var(--ease-in-out) infinite alternate;
    will-change: transform;
  }

  @keyframes air-drift {
    from {
      transform: translate3d(-1.5%, 0, 0) scale(1);
    }
    to {
      transform: translate3d(1.5%, -1%, 0) scale(1.04);
    }
  }

  /* przyciemnienie pod tekstem i zejście sceny w kolor strony */
  .cine__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(13 19 17 / 0.5) 0%, rgb(13 19 17 / 0.12) 34%, transparent 52%),
      linear-gradient(to top, var(--ink-900) 0%, rgb(13 19 17 / 0) 16%);
    pointer-events: none;
  }

  .cine__copy {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 1rem;
    padding-top: calc(var(--header-h) + clamp(2rem, 0.5rem + 6vh, 5rem));
    will-change: transform, opacity;
  }

  .cine__copy .display {
    text-shadow: 0 1px 24px rgb(13 19 17 / 0.35);
  }

  .cine__lede {
    max-width: 36rem;
    color: #e6e4de;
    text-shadow: 0 1px 16px rgb(13 19 17 / 0.4);
  }

  .cine__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.75rem;
  }

  .hero__form {
    display: flex;
    align-items: center;
    height: 3.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: rgb(236 235 230 / 0.16);
    border: 1px solid rgb(236 235 230 / 0.22);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition:
      border-color var(--dur-1) ease,
      background-color var(--dur-1) ease;
  }

  .hero__form:focus-within {
    border-color: rgb(236 235 230 / 0.6);
    background: rgb(236 235 230 / 0.2);
  }

  .hero__form input {
    width: 14.5rem;
    min-width: 0;
    height: 100%;
    padding-inline: 1.125rem 0.5rem;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
    color: var(--text);
  }

  .hero__form input::placeholder {
    color: #d6d5cf;
    opacity: 1;
  }

  .hero__form .btn {
    height: 100%;
  }

  .cine__demo {
    height: 3.25rem;
    padding-inline: 1.375rem;
    background: rgb(236 235 230 / 0.12);
    border-color: rgb(236 235 230 / 0.22);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  /* --- Brama i ekran -------------------------------------------------------
     Zestaw jest układany w rozmiarze docelowym (ekran = --wf) i pomniejszany
     transformacją, więc po najeździe interfejs jest ostry. 1em = 1% szerokości ekranu. */
  .cine__rig {
    --wf: 100vw;
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--wf);
    font-size: calc(var(--wf) / 100);
    transform: translate3d(-50%, -20%, 0) scale(0.3);
    transform-origin: 50% 50%;
    opacity: 0;
    transition: opacity 700ms ease 200ms;
    will-change: transform;
    z-index: 1;
  }

  .cine__rig:global(.is-ready) {
    opacity: 1;
  }

  .portal {
    position: absolute;
    left: -23em;
    right: -23em;
    top: -79em;
    bottom: -16em;
    will-change: opacity;
  }

  /* łuk: światło bije od podłogi, obrys łapie mosiężny refleks */
  .portal__light {
    position: absolute;
    inset: 0;
    border-radius: 73em 73em 0 0;
    background:
      radial-gradient(70% 46% at 50% 100%, #f3cf9f 0%, #d49a63 20%, rgb(140 98 62 / 0.75) 42%, rgb(40 52 46 / 0.6) 68%, rgb(13 19 17 / 0.2) 100%),
      linear-gradient(to top, #2a332e 0%, #121916 60%, #0b100e 100%);
    box-shadow:
      inset 0 0 0 0.16em rgb(217 187 128 / 0.5),
      inset 0 0 9em rgb(13 19 17 / 0.55),
      0 0 22em -2em rgb(217 170 118 / 0.42);
  }

  /* odbicie światła na posadzce przed bramą */
  .portal__floor {
    position: absolute;
    left: -30%;
    right: -30%;
    top: 100%;
    height: 46em;
    background: radial-gradient(50% 100% at 50% 0%, rgb(217 170 118 / 0.42), rgb(217 170 118 / 0.08) 48%, transparent 76%);
    border-top: 0.12em solid rgb(217 187 128 / 0.3);
  }

  .cine__screen {
    position: relative;
    border-radius: 0.7em;
    overflow: hidden;
    box-shadow:
      0 0 0 0.1em rgb(236 235 230 / 0.16),
      0 3em 8em -1em rgb(0 0 0 / 0.75);
  }

  .cine__hint {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9cec8;
  }

  .cine__hint i {
    width: 1px;
    height: 2rem;
    background: linear-gradient(to bottom, #c9cec8, transparent);
    transform-origin: 50% 0;
    animation: cine-hint 2.2s var(--ease-in-out) infinite;
  }

  @keyframes cine-hint {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .hero__form {
      width: 100%;
    }

    .hero__form input {
      flex: 1;
      width: auto;
    }

    .cine__actions,
    .cine__demo {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .cine {
      height: 100svh;
    }
  }
</style>
