---
---

<section class="hero theme-dark">
  <canvas class="hero__canvas" data-ridge aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 class="display" data-reveal>Agenci AI, którzy domykają pracę</h1>
    <p class="lede hero__lede" data-reveal style="--reveal-i:1">
      Wdrażamy agentów tam, gdzie Twój zespół dziś przepisuje dane między systemami.
      Z&nbsp;człowiekiem przy wyjątkach i&nbsp;dziennikiem każdej decyzji.
    </p>

    <div class="hero__actions" data-reveal style="--reveal-i:2">
      <form class="hero__form" action="/kontakt/" method="get">
        <label class="visually-hidden" for="hero-email">Służbowy adres e-mail</label>
        <input
          id="hero-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="Służbowy e-mail"
          required
        />
        <button class="btn btn--primary" type="submit">Umów rozmowę</button>
      </form>
      <a class="btn btn--ghost hero__demo" href="/sandbox/">Otwórz sandbox</a>
    </div>
  </div>

  <div class="container hero__stage">
    <div class="case-card" data-hero-case aria-hidden="true">
      <div class="case-card__head">
        <span class="mono case-card__id" data-case-id>ZAM-2291</span>
        <span class="case-card__title" data-case-title>Zamówienie · Hurtownia Bałtyk</span>
        <span class="chip" data-case-chip>W toku</span>
      </div>
      <ol class="case-card__steps">
        {
          ['Odczyt wiadomości', 'Ceny i stany magazynowe', 'Decyzja według reguł', 'Zapis w ERP i odpowiedź'].map((s) => (
            <li data-case-step>
              <span class="case-card__tick">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
                  <circle class="ring" cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.25" />
                  <path class="check" d="M5 8.2l2 2 4-4.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span data-case-step-label>{s}</span>
              <span class="mono case-card__meta" data-case-step-meta></span>
            </li>
          ))
        }
      </ol>
      <div class="case-card__foot">
        <span data-case-foot>Agent pracuje…</span>
        <span class="mono" data-case-time>0 s</span>
      </div>
    </div>
    <p class="micro hero__note">Symulacja · dane przykładowe</p>
  </div>
</section>

<script>
  import { mountRidge } from '../scripts/ridge';
  import { mountHeroCase } from '../scripts/hero-case';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ridge]');
  if (canvas) mountRidge(canvas);

  const card = document.querySelector<HTMLElement>('[data-hero-case]');
  if (card) mountHeroCase(card);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: max(46rem, min(100svh, 62rem));
    background: var(--ink-900);
    color: var(--text);
    overflow: clip;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  /* Zejście krajobrazu w kolor następnej sekcji */
  .hero__veil {
    position: absolute;
    inset: auto 0 0 0;
    height: 22%;
    background: linear-gradient(to bottom, rgb(13 19 17 / 0), var(--ink-900));
    z-index: -1;
    pointer-events: none;
  }

  .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-top: calc(var(--header-h) + clamp(3.5rem, 1rem + 8vh, 6.5rem));
  }

  .hero__lede {
    max-width: 39rem;
    color: #c5cbc5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .hero__form {
    display: flex;
    align-items: center;
    height: 3.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: rgb(236 235 230 / 0.09);
    border: 1px solid rgb(236 235 230 / 0.16);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      border-color var(--dur-1) ease,
      background-color var(--dur-1) ease;
  }

  .hero__form:focus-within {
    border-color: rgb(236 235 230 / 0.5);
    background: rgb(236 235 230 / 0.12);
  }

  .hero__form input {
    width: 15.5rem;
    min-width: 0;
    height: 100%;
    padding-inline: 1.125rem 0.5rem;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
    color: var(--text);
  }

  .hero__form input::placeholder {
    color: #aab2ac;
    opacity: 1;
  }

  .hero__form .btn {
    height: 100%;
  }

  .hero__demo {
    height: 3.25rem;
    padding-inline: 1.375rem;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .hero__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-content: end;
    gap: 0.875rem;
    padding-block: 3rem 2.25rem;
  }

  .hero__note {
    color: #8b958f;
  }

  /* Karta sprawy — szkło nad krajobrazem */
  .case-card {
    width: min(100%, 27.5rem);
    border-radius: 16px;
    background: rgb(17 24 21 / 0.72);
    border: 1px solid rgb(236 235 230 / 0.12);
    box-shadow:
      0 30px 80px -30px rgb(0 0 0 / 0.75),
      inset 0 1px 0 rgb(236 235 230 / 0.06);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    font-size: var(--text-sm);
    text-align: left;
  }

  .case-card__head,
  .case-card__steps,
  .case-card__foot {
    transition: opacity 300ms ease;
  }

  .case-card.is-swapping .case-card__head,
  .case-card.is-swapping .case-card__steps,
  .case-card.is-swapping .case-card__foot {
    opacity: 0;
  }

  .case-card__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .case-card__id {
    font-size: var(--text-2xs);
    color: var(--text-3);
  }

  .case-card__title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .case-card__steps {
    display: grid;
    padding: 0.5rem 1rem;
  }

  .case-card__steps li {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.125rem;
    color: var(--text-3);
    transition: color var(--dur-2) ease;
  }

  .case-card__meta {
    font-size: var(--text-2xs);
    color: var(--text-3);
    opacity: 0;
    transition: opacity var(--dur-2) ease;
  }

  .case-card__tick {
    color: var(--ink-500);
    transition: color var(--dur-2) ease;
  }

  .case-card__tick .check {
    stroke-dasharray: 10;
    stroke-dashoffset: 10;
    transition: stroke-dashoffset var(--dur-3) var(--ease-out);
  }

  .case-card__steps li.is-active {
    color: var(--text);
  }

  .case-card__steps li.is-active .case-card__tick {
    color: var(--text-2);
  }

  .case-card__steps li.is-active .ring {
    stroke-dasharray: 9 30.3;
    transform-origin: 8px 8px;
    animation: tick-spin 900ms linear infinite;
  }

  .case-card__steps li.is-done {
    color: var(--text-2);
  }

  .case-card__steps li.is-done .case-card__tick {
    color: var(--accent);
  }

  .case-card__steps li.is-done .check {
    stroke-dashoffset: 0;
  }

  .case-card__steps li.is-done .case-card__meta,
  .case-card__steps li.is-hold .case-card__meta {
    opacity: 1;
  }

  .case-card__steps li.is-hold {
    color: var(--warn);
  }

  .case-card__steps li.is-hold .case-card__tick,
  .case-card__steps li.is-hold .case-card__meta {
    color: var(--warn);
  }

  .case-card__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  @keyframes tick-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 560px) {
    .hero__form {
      width: 100%;
    }

    .hero__form input {
      flex: 1;
      width: auto;
    }

    .hero__actions {
      width: 100%;
    }

    .hero__demo {
      width: 100%;
    }
  }
</style>
