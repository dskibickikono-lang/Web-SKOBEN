---
/**
 * Hero: pełnoekranowa scena biura o błękitnej godzinie (docs/art-direction.md, §4–5).
 *
 * Scena jest przypięta na czas przewijania:
 *  A  0–50% drogi   film sterowany przewijaniem — kamera najeżdża na monitor,
 *                   nagłówek gaśnie w miejscu;
 *  B  50–82%        kadr powiększa się w oś ekranu monitora, na ekranie pojawia
 *                   się żywa konsola i rośnie do czytelnego panelu, pokój rozpływa
 *                   się w tle strony;
 *  C  82–100%       pod panelem pojawia się podpis.
 * Przy ograniczonym ruchu i bez JS zostaje statyczny kadr z nagłówkiem.
 */
import Film from './Film.astro';
---

<section class="hero" data-hero data-theme="dark">
  <div class="hero__stage">
    <div class="hero__scene" data-hero-scene>
      <picture>
        <source media="(max-width: 759px), (max-aspect-ratio: 4/5)" srcset="/media/hero/office-portrait-poster.webp" />
        <img
          class="hero__poster"
          src="/media/hero/office-landscape-poster.webp"
          alt="Puste biuro o świcie: szerokie biurko, monitor i równo ułożony stos dokumentów na tle okna"
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <video class="hero__video" data-hero-video muted playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__copy" data-hero-copy>
      <h1 class="display" data-rise>Praca, która <em>domyka się</em> sama</h1>
      <p class="lede hero__lede" data-rise>
        SKOBEN wprowadza firmy w operacje prowadzone przez agentów AI. Zamówienia, faktury i&nbsp;zgłoszenia
        zamykają się bez przepisywania — z&nbsp;człowiekiem przy wyjątkach.
      </p>
      <div class="hero__actions" data-rise>
        <form class="hero__form" action="/kontakt/" method="get">
          <label class="visually-hidden" for="hero-email">Służbowy adres e-mail</label>
          <input id="hero-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Służbowy e-mail" required />
          <button class="btn btn--primary" type="submit">Poproś o dostęp</button>
        </form>
        <a class="btn btn--glass" href="/sandbox/">Otwórz sandbox</a>
      </div>
    </div>

    <p class="hero__pill" data-hero-pill>Wdrażamy równolegle tylko kilka firm — żeby każdy proces dowieźć do końca.</p>

    <div class="hero__console" data-hero-console aria-hidden="true">
      <Film id="hero" />
    </div>

    <div class="hero__caption" data-hero-caption>
      <p class="label">Konsola operacyjna · działa na żywo, to nie nagranie</p>
      <a class="link" href="/sandbox/">Przejmij stery w sandboxie</a>
    </div>
  </div>
</section>

<script>
  import { mountFilm, whenIdle } from '../scripts/sandbox/film';

  const section = document.querySelector<HTMLElement>('[data-hero]');
  const stage = section?.querySelector<HTMLElement>('.hero__stage');
  const scene = section?.querySelector<HTMLElement>('[data-hero-scene]');
  const video = section?.querySelector<HTMLVideoElement>('[data-hero-video]');
  const copy = section?.querySelector<HTMLElement>('[data-hero-copy]');
  const pill = section?.querySelector<HTMLElement>('[data-hero-pill]');
  const consoleEl = section?.querySelector<HTMLElement>('[data-hero-console]');
  const caption = section?.querySelector<HTMLElement>('[data-hero-caption]');
  const filmEl = section?.querySelector<HTMLElement>('[data-film]');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && stage && scene && video && copy && pill && consoleEl && caption && filmEl && !reduce) {
    section.classList.add('is-live');

    /** Położenie ekranu monitora w ostatniej klatce filmu (ułamki kadru). */
    const CLIPS = {
      landscape: { w: 1920, h: 1080, sx: 0.3927, sy: 0.5037, sw: 0.2167, sh: 0.213 },
      portrait: { w: 1080, h: 1920, sx: 0.305, sy: 0.481, sw: 0.385, sh: 0.117 },
    };
    const FILM_RATIO = 1180 / 652;
    const HEADER = 72;

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    let W = 0;
    let H = 0;
    let portrait = false;
    // prostokąty w pikselach sceny: ekran monitora (S) i docelowy panel konsoli (C)
    let S = { x: 0, y: 0, w: 1, h: 1 };
    let C = { x: 0, y: 0, w: 1, h: 1 };
    let loadedSrc = '';
    let target = 0;
    let shown = 0;
    let raf = 0;
    let ticking = false;

    const measure = () => {
      W = stage.clientWidth;
      H = stage.clientHeight;
      portrait = W < 760 || W / H < 0.8;
      const clip = portrait ? CLIPS.portrait : CLIPS.landscape;

      // kadr wypełnia scenę jak object-fit: cover
      const k = Math.max(W / clip.w, H / clip.h);
      const dw = clip.w * k;
      const dh = clip.h * k;
      const ox = (W - dw) / 2;
      const oy = (H - dh) / 2;
      S = { x: ox + clip.sx * dw, y: oy + clip.sy * dh, w: clip.sw * dw, h: clip.sh * dh };

      // panel konsoli: na desktopie cała konsola, na telefonie czytelny wycinek z kamerą
      const ratio = portrait ? 0.74 : FILM_RATIO;
      const cw = portrait ? W - 32 : Math.min(1024, W - 64, (H - HEADER - 150) * ratio);
      C = { x: (W - cw) / 2, y: HEADER + (portrait ? 20 : 28), w: cw, h: cw / ratio };
      consoleEl.style.left = `${C.x}px`;
      consoleEl.style.top = `${C.y}px`;
      consoleEl.style.width = `${C.w}px`;
      caption.style.top = `${C.y + C.h + (portrait ? 20 : 28)}px`;
      scene.style.transformOrigin = `${S.x + S.w / 2}px ${S.y + S.h / 2}px`;

      const src = portrait ? '/media/hero/office-portrait-720.mp4' : W >= 1100 ? '/media/hero/office-landscape-1080.mp4' : '/media/hero/office-landscape-720.mp4';
      if (src !== loadedSrc) {
        loadedSrc = src;
        video.preload = 'auto';
        video.src = src;
        video.load();
      }
      update();
    };

    const update = () => {
      ticking = false;
      const span = Math.max(1, section.offsetHeight - H);
      const p = clamp(-section.getBoundingClientRect().top / span);
      const a = clamp(p / 0.5);
      const b = ease(clamp((p - 0.5) / 0.32));
      const c = clamp((p - 0.84) / 0.12);

      // A: film
      const duration = Number.isFinite(video.duration) ? video.duration : 5;
      target = a * Math.max(0, duration - 0.06);
      if (!raf) raf = requestAnimationFrame(seek);

      // nagłówek gaśnie w miejscu
      const fade = clamp((p - 0.05) / 0.1);
      copy.style.opacity = String(1 - fade);
      copy.style.filter = fade > 0 && fade < 1 ? `blur(${(fade * 6).toFixed(1)}px)` : '';
      copy.style.visibility = fade >= 1 ? 'hidden' : 'visible';
      pill.style.opacity = String(1 - clamp(p / 0.05));

      // B: panel rośnie z ekranu monitora do rozmiaru docelowego, kadr podąża za nim
      const k0 = S.w / C.w;
      const k = lerp(k0, 1, b);
      const cx = lerp(S.x + S.w / 2, C.x + C.w / 2, b);
      const cy = lerp(S.y + S.h / 2, C.y + C.h / 2, b);
      consoleEl.style.transform = `translate3d(${cx - (k * C.w) / 2 - C.x}px, ${cy - (k * C.h) / 2 - C.y}px, 0) scale(${k})`;
      consoleEl.style.opacity = String(clamp((p - 0.5) / 0.08));
      // na telefonie panel jest wyższy niż ekran monitora — odsłania się pionowo
      const inset = Math.max(0, (C.h - S.h / k0) / 2) * (1 - b);
      consoleEl.style.clipPath = `inset(${inset.toFixed(1)}px 0 round ${(12 / k).toFixed(1)}px)`;
      consoleEl.style.visibility = p > 0.49 ? 'visible' : 'hidden';

      const z = (k * C.w) / S.w;
      scene.style.transform = `translate3d(${cx - (S.x + S.w / 2)}px, ${cy - (S.y + S.h / 2)}px, 0) scale(${z})`;
      scene.style.opacity = String(1 - clamp((b - 0.3) / 0.5));
      document.documentElement.classList.toggle('over-scene', b < 0.45);

      // C: podpis
      caption.style.opacity = String(c);
      caption.style.transform = `translate3d(-50%, ${(1 - c) * 16}px, 0)`;
      caption.style.visibility = c > 0 ? 'visible' : 'hidden';
    };

    /** Wygładzone ustawianie klatki filmu — bez szarpania przy szybkim przewijaniu. */
    const seek = () => {
      raf = 0;
      const diff = target - shown;
      if (Math.abs(diff) < 0.004 || video.readyState < 2) {
        if (video.readyState < 2 && Math.abs(diff) >= 0.004) raf = requestAnimationFrame(seek);
        return;
      }
      shown += diff * 0.22;
      if (Math.abs(target - shown) < 0.004) shown = target;
      video.currentTime = shown;
      raf = requestAnimationFrame(seek);
    };

    video.addEventListener('loadeddata', () => {
      section.classList.add('has-video');
      update();
    });

    // iOS pokazuje klatki przewijanego filmu dopiero po pierwszym odtworzeniu
    const prime = () => {
      video.play().then(() => video.pause()).catch(() => {});
    };
    window.addEventListener('touchstart', prime, { once: true, passive: true });

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', measure, { passive: true });

    // konsola: na telefonie wycinek z kamerą podążającą za kursorem
    if (window.innerWidth < 760) {
      filmEl.setAttribute('data-pan', '');
      filmEl.style.setProperty('--film-aspect', '0.74');
    }
    measure();
    whenIdle(() => mountFilm(filmEl, { loop: true }).play('orders'));
  }

  // Adres e-mail przekazujemy do formularza kontaktowego przez pamięć sesji,
  // nie w adresie URL — nie trafia do historii ani logów serwera.
  const heroForm = document.querySelector<HTMLFormElement>('.hero__form');
  heroForm?.addEventListener('submit', (e) => {
    const input = heroForm.querySelector<HTMLInputElement>('input[type="email"]');
    if (!input || !heroForm.checkValidity()) return;
    try {
      window.sessionStorage.setItem('skoben:email', input.value.trim());
    } catch {
      return; // bez pamięci sesji zostaje zwykłe wysłanie formularza (GET)
    }
    e.preventDefault();
    window.location.assign(heroForm.action);
  });
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 38rem;
    color: #ededf2;
  }

  /* Z ruchem sekcja jest dłuższa: nadmiar wysokości to droga kamery */
  .hero:global(.is-live) {
    height: 340svh;
  }

  .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 38rem;
    overflow: clip;
    isolation: isolate;
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: -2;
    will-change: transform, opacity;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
  }

  .hero:global(.has-video) .hero__video {
    opacity: 1;
  }

  /* czytelność nawigacji i nagłówka: przyciemnienie tylko u góry kadru */
  .hero__shade {
    position: absolute;
    inset: 0 0 auto 0;
    height: 46%;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(21 21 27 / 0.62), rgb(21 21 27 / 0.28) 55%, transparent);
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1rem;
    max-width: 44rem;
    margin-inline: auto;
    padding: calc(var(--header-h) + clamp(2.5rem, 1rem + 7vh, 4.5rem)) var(--gutter) 0;
    text-align: center;
    will-change: opacity, filter;
  }

  .hero__lede {
    max-width: 34rem;
    color: #d9dae3;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .hero__form {
    display: flex;
    align-items: center;
    height: 3.125rem;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: rgb(175 178 206 / 0.2);
    border: 1px solid rgb(175 178 206 / 0.36);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .hero__form:focus-within {
    border-color: rgb(237 237 242 / 0.7);
  }

  .hero__form input {
    width: 14rem;
    min-width: 0;
    height: 100%;
    padding-inline: 1rem 0.5rem;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
    color: #ededf2;
  }

  .hero__form input::placeholder {
    color: #d0d1dc;
    opacity: 1;
  }

  .hero__form .btn {
    height: 100%;
  }

  .hero__actions > .btn {
    height: 3.125rem;
  }

  /* pastylka u dołu kadru */
  .hero__pill {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: max-content;
    max-width: calc(100% - 2 * var(--gutter));
    padding: 0.625rem 1rem;
    border-radius: var(--radius);
    background: rgb(28 28 35 / 0.72);
    border: 1px solid rgb(175 178 206 / 0.22);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transform: translateX(-50%);
    font-size: var(--text-xs);
    line-height: 1.4;
    text-align: center;
    color: #d9dae3;
  }

  /* panel konsoli: jedyny element strony z cieniem */
  .hero__console {
    position: absolute;
    transform-origin: 0 0;
    border-radius: var(--radius);
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    box-shadow:
      0 0 0 1px rgb(175 178 206 / 0.24),
      0 40px 100px -40px rgb(0 0 0 / 0.8);
    will-change: transform, opacity;
  }

  .hero__caption {
    position: absolute;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: calc(100% - 2 * var(--gutter));
    text-align: center;
    visibility: hidden;
    opacity: 0;
    transform: translateX(-50%);
  }

  /* kadr pionowy ma jasne okno tuż pod sufitem — tekst potrzebuje dłuższego przyciemnienia */
  @media (max-width: 759px), (max-aspect-ratio: 4/5) {
    .hero__shade {
      height: 66%;
      background: linear-gradient(to bottom, rgb(21 21 27 / 0.82), rgb(21 21 27 / 0.62) 58%, transparent);
    }
  }

  @media (max-width: 560px) {
    .hero__form {
      width: 100%;
    }

    .hero__form input {
      flex: 1;
      width: auto;
    }

    .hero__actions,
    .hero__actions > .btn {
      width: 100%;
    }
  }
</style>
