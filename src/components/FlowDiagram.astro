---
/**
 * Diagram przepływu: źródła → agent → systemy docelowe, z pętlą akceptacji.
 * Węzły to HTML (czytelny tekst, responsywność), połączenia to SVG z sygnałami
 * poruszającymi się po ścieżkach (SMIL animateMotion).
 */
interface Props {
  /** Unikalny prefiks identyfikatorów ścieżek SVG (gdy diagramów na stronie jest więcej). */
  id?: string;
  sources?: string[];
  targets?: string[];
}

const {
  id: uid = 'flow',
  sources = ['Poczta i załączniki', 'Pliki, EDI, portale', 'Formularze i API'],
  targets = ['ERP i magazyn', 'CRM i helpdesk', 'Księgowość i BI'],
} = Astro.props;

const H = 336;
const ys = [H / 6, H / 2, (H * 5) / 6];
const stages = ['Odczyt', 'Walidacja', 'Decyzja', 'Zapis'];
---

<div class="flow" data-flow>
  <ul class="flow__col" aria-label="Źródła">
    {sources.map((s) => <li class="node">{s}</li>)}
  </ul>

  <svg class="flow__wire" viewBox={`0 0 120 ${H}`} width="120" height={H} fill="none" aria-hidden="true">
    {
      ys.map((y, i) => (
        <>
          <path id={`in-${uid}-${i}`} d={`M0 ${y}C60 ${y} 60 ${H / 2} 120 ${H / 2}`} class="wire" />
          <circle r="3" class="pulse">
            <animateMotion dur={`${3.2 + i * 0.7}s`} begin={`-${i * 0.9}s`} repeatCount="indefinite">
              <mpath href={`#in-${uid}-${i}`} />
            </animateMotion>
          </circle>
        </>
      ))
    }
  </svg>

  <div class="flow__agent">
    <div class="agent">
      <div class="agent__head">
        <span class="label">Agent SKOBEN</span>
        <span class="chip chip--ok">Aktywny</span>
      </div>
      <ol class="agent__stages">
        {
          stages.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="mono">0{i + 1}</span>
              {s}
            </li>
          ))
        }
      </ol>
      <div class="agent__foot">
        <span>Reguły i progi</span>
        <span>Dziennik decyzji</span>
      </div>
    </div>
    <div class="human">
      <svg viewBox="0 0 40 44" width="40" height="44" fill="none" aria-hidden="true">
        <path d="M20 0v44" class="wire wire--warn" />
        <circle r="3" class="pulse pulse--warn">
          <animateMotion dur="4.5s" repeatCount="indefinite" path="M20 0V44" keyPoints="0;1;1;0" keyTimes="0;0.4;0.6;1" calcMode="linear" />
        </circle>
      </svg>
      <div class="node node--warn">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
          <circle cx="8" cy="5.5" r="2.6" stroke="currentColor" stroke-width="1.3" />
          <path d="M3 13.5c.8-2.6 2.7-4 5-4s4.2 1.4 5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        Człowiek zatwierdza wyjątki
      </div>
    </div>
  </div>

  <svg class="flow__wire" viewBox={`0 0 120 ${H}`} width="120" height={H} fill="none" aria-hidden="true">
    {
      ys.map((y, i) => (
        <>
          <path id={`out-${uid}-${i}`} d={`M0 ${H / 2}C60 ${H / 2} 60 ${y} 120 ${y}`} class="wire" />
          <circle r="3" class="pulse">
            <animateMotion dur={`${3.6 + i * 0.6}s`} begin={`-${1.4 + i * 0.8}s`} repeatCount="indefinite">
              <mpath href={`#out-${uid}-${i}`} />
            </animateMotion>
          </circle>
        </>
      ))
    }
  </svg>

  <ul class="flow__col" aria-label="Systemy docelowe">
    {targets.map((s) => <li class="node">{s}</li>)}
  </ul>
</div>

<style>
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1.5fr) 120px minmax(0, 1fr);
    align-items: start;
  }

  .flow__col {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    height: 336px;
    align-items: center;
  }

  .node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-size: var(--text-sm);
    font-weight: 480;
    line-height: 1.3;
  }

  .node--warn {
    border-color: color-mix(in srgb, var(--warn) 50%, transparent);
    color: var(--warn);
    background: var(--warn-soft);
    justify-content: center;
  }

  .flow__wire {
    width: 120px;
    height: 336px;
    overflow: visible;
  }

  .wire {
    stroke: var(--line-2);
    stroke-width: 1;
  }

  .wire--warn {
    stroke: var(--warn);
    stroke-opacity: 0.6;
    stroke-dasharray: 3 4;
  }

  .pulse {
    fill: var(--accent);
  }

  .pulse--warn {
    fill: var(--warn);
  }

  .flow__agent {
    display: grid;
    justify-items: center;
  }

  .agent {
    display: grid;
    align-content: space-between;
    width: 100%;
    height: 336px;
    border-radius: 16px;
    border: 1px solid var(--line-2);
    background:
      radial-gradient(120% 80% at 50% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow-panel);
  }

  .agent__head,
  .agent__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .agent__foot {
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .agent__stages {
    display: grid;
    gap: 0.5rem;
    padding-inline: 1.25rem;
  }

  .agent__stages li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    height: 2.5rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--text) 5%, transparent);
    font-weight: 480;
    font-size: var(--text-sm);
    animation: stage-glow 6s linear infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }

  .agent__stages .mono {
    font-size: var(--text-2xs);
    color: var(--text-3);
  }

  @keyframes stage-glow {
    0%,
    22% {
      background: color-mix(in srgb, var(--accent) 16%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
    }
    30%,
    100% {
      background: color-mix(in srgb, var(--text) 5%, transparent);
      box-shadow: inset 0 0 0 1px transparent;
    }
  }

  .human {
    display: grid;
    justify-items: center;
  }

  @media (max-width: 900px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
      gap: 0;
    }

    .flow__col {
      height: auto;
      grid-template-rows: none;
      gap: 0.5rem;
    }

    .flow__wire {
      display: none;
    }

    /* pionowy łącznik między blokami */
    .flow__agent::before,
    .flow__agent::after {
      content: '';
      width: 1px;
      height: 2rem;
      background: var(--line-2);
    }

    .flow__agent::after {
      order: 2;
    }

    .human {
      order: 1;
      width: 100%;
    }

    .human .node {
      width: 100%;
    }

    .agent {
      height: auto;
      gap: 0.75rem;
    }
  }
</style>
